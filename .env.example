# Eldorado.gg Order Monitor Bot - Environment Configuration

# Gmail Configuration
GMAIL_USER=
GMAIL_APP_PASSWORD=
SENDER_FILTER=eldorado.gg

# Telegram Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Monitoring Configuration
CHECK_INTERVAL_SECONDS=20
MAX_EMAILS_TO_CHECK=50
SEEN_UIDS_LIMIT=500

# Redis Configuration (optional, for improved reliability)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
LOG_MAX_SIZE_MB=10
LOG_BACKUP_COUNT=5

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PORT=8000

# Additional Configuration
# You can add more configuration options here as needed